# Copy to .env on the server and fill in every value. Never commit .env.

# Public address. A domain whose DNS A record points at this server gets HTTPS automatically.
# Use :80 to test on the bare IP over plain HTTP first.
DOMAIN=rooms.example.com

# Generate each secret with:  openssl rand -base64 32
DB_PASSWORD=
JWT_SECRET=
# Password for the "admin" account (at least 12 characters). Applied on every start.
ADMIN_PASSWORD=

# Image tag published by CI: "latest" or a specific "sha-<7 chars>" to pin/roll back.
IMAGE_TAG=latest
# GITHUB_REPOSITORY=altynidev/room_booking
